# Kiro CLI pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.pre.zsh"

# ═══════════════════════════════════════════════════════════
#  .zshrc — thin loader
# ═══════════════════════════════════════════════════════════
#  ~/.zshrc is a symlink to this file, which lives in the
#  beautify repo so the whole setup is version-controlled and
#  migrates to a new Mac with `git clone` + `./install.sh`.
#
#  All real configuration lives in ./zsh/*.zsh, loaded in
#  numeric order. See zsh/README.md for what each file does.
#
#  Deliberately NOT loaded here:
#    ~/.zprofile and ~/.profile — those are LOGIN-shell files.
#    The previous version sourced both from the interactive
#    shell, which is what made ~/.docker/bin accumulate in PATH
#    seven times. They still run for login shells on their own.
# ═══════════════════════════════════════════════════════════

# Only act in an interactive shell. Non-interactive shells (scripts,
# `zsh -c`, cron) must not pay for any of this — they inherit PATH
# from their parent, and a login shell still gets ~/.zprofile.
[[ -o interactive ]] || return

# Locate the module directory relative to THIS file, not to $0.
# In a zsh startup file $0 is the shell's argv0 (e.g. "-zsh"), not
# the rc path, so ${0:A:h} silently resolves to the wrong place and
# every module goes un-sourced.
#
# The path is assigned to a variable first on purpose: applying the
# :A modifier to a nested expansion like ${${ZDOTDIR:-$HOME}/.zshrc:A}
# does not resolve symlinks, it just yields the parent directory.
_zshrc="${ZDOTDIR:-$HOME}/.zshrc"
ZSH_CONFIG_DIR="${_zshrc:A:h}/zsh"
unset _zshrc

# :A follows the symlink, so:
#   ~/.zshrc -> <repo>/config/zshrc   =>  <repo>/config/zsh/
#   ~/.zshrc is a real file           =>  ~/.zsh/
# The same layout therefore works whether this file is symlinked
# into a repo or installed as a plain file.

if [[ ! -d $ZSH_CONFIG_DIR ]]; then
  print -u2 "zsh: config dir not found: $ZSH_CONFIG_DIR"
  print -u2 "zsh: falling back to a minimal prompt; check the symlink: ls -l ${ZDOTDIR:-$HOME}/.zshrc"
  autoload -Uz colors && colors
  PROMPT='%F{cyan}%~%f %# '
  return
fi

# Load order is enforced by the numeric filename prefix, not by an
# array here, so a new file dropped into the directory just works.
for _zsh_module in "$ZSH_CONFIG_DIR"/[0-9][0-9]-*.zsh(N); do
  source "$_zsh_module"
done
unset _zsh_module

# Keep the window/tab title in step with the directory.
# Declared here (rather than in a module) so it applies regardless
# of which module set up the prompt.
autoload -Uz add-zsh-hook
set_win_title() {
  print -Pn '\e]0; %~  (%n@%m)\a'
}
add-zsh-hook precmd set_win_title

# opencode CLI
export PATH="$HOME/.opencode/bin:$PATH"

# Kiro CLI post block. Keep at the bottom of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"
