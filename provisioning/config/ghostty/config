# ═══════════════════════════════════════════════════════════
# Ghostty Terminal Configuration — 2026 best-in-class
# Ghostty 1.3.x · macOS · Chroma themes
# Mirrors beautify/config/ghostty/config (single source of truth).
# ═══════════════════════════════════════════════════════════

# ── Font & Typography ──────────────────────────────────────
# MONOSPACED Nerd Font variant (NFM): Ghostty does its own
# cell-alignment for Nerd Font glyphs, so the mono build keeps
# every icon exactly one cell wide (lazygit/btop/starship
# borders stay on-grid). The proportional "NF" build made
# prompt icons / ASCII-art columns drift off-grid.
font-family = JetBrainsMono Nerd Font Mono
font-family-bold = JetBrainsMono Nerd Font Mono
font-family-italic = JetBrainsMono Nerd Font Mono
font-family-bold-italic = JetBrainsMono Nerd Font Mono
# Symbols Nerd Font fallback: any glyph the primary font lacks
# (extra NF icons) drops to the symbols font instead of tofu.
font-family = Symbols Nerd Font
font-size = 14
font-thicken = true
# Ligatures + slashed/relaxed zero for a modern code look.
font-feature = calt
font-feature = liga
font-feature = zero

# ── Theme ──────────────────────────────────────────────────
# Used when no Chroma theme is applied yet (install.sh --theme
# writes ~/.config/ghostty/theme.ghostty, included below).
theme = Catppuccin Mocha
minimum-contrast = 1.1
palette-generate = true

# ── Background & Transparency ──────────────────────────────
background-opacity = 0.88
# blur intensity 30 (background-blur-radius is not a Ghostty key)
background-blur = 30
alpha-blending = linear-corrected

# ── Window & Appearance ────────────────────────────────────
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
macos-titlebar-style = transparent
macos-non-native-fullscreen = true
macos-option-as-alt = left
window-save-state = always
window-step-resize = true
window-vsync = true

# ── Cursor & Mouse ─────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.85
cursor-click-to-move = true
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# ── Splits & Window Polish ─────────────────────────────────
unfocused-split-opacity = 0.92
split-divider-color = #313244
split-preserve-zoom = navigation
grapheme-width-method = unicode

# ── Shell Integration ──────────────────────────────────────
shell-integration = detect
shell-integration-features = cursor,sudo,title,path

# ── Command Finished Notifications ─────────────────────────
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

# ── Scrollback (50M chars ~50MB) ───────────────────────────
scrollback-limit = 50000000

# ── Quick Terminal (Quake-style dropdown) ──────────────────
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# ── Keybindings: Splits ────────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom
keybind = cmd+alt+h=resize_split:left,5
keybind = cmd+alt+l=resize_split:right,5
keybind = cmd+alt+k=resize_split:up,5
keybind = cmd+alt+j=resize_split:down,5
keybind = cmd+shift+z=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

# ── Keybindings: Tabs ──────────────────────────────────────
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+[=previous_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5
keybind = cmd+9=last_tab

# ── Keybindings: Font Size ─────────────────────────────────
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# ── Keybindings: Search ────────────────────────────────────
keybind = cmd+f=start_search

# ── Keybindings: Quick Terminal ────────────────────────────
keybind = ctrl+`=toggle_quick_terminal

# ── Chroma theme hook (managed by beautify/install.sh) ─────
# install.sh --theme <name> writes the palette to
# ~/.config/ghostty/theme.ghostty (this include is optional,
# so Ghostty starts fine before any theme is applied). Included
# keys override the main config above.
config-file = ?theme.ghostty