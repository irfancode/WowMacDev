# ── Ghostty Configuration ──────────────────────────────────
# Version: 1.3.1 — Last updated: June 2026

# ── Font & Typography ─────────────────────────────────────
# Use the MONOSPACED Nerd Font variant (NFM). Ghostty performs its own
# cell-alignment + scaling for Nerd Font glyphs, and per the Ghostty docs it
# behaves best with the mono (NFM) build rather than the proportional "NF".
# The proportional variant is what makes prompt icons / ASCII art columns sit
# off-grid; NFM keeps every glyph exactly one cell wide.
font-family = JetBrainsMono Nerd Font Mono
# Fallback so any glyph the primary font lacks falls through to the symbols
# font Ghostty ships with, instead of rendering as tofu.
font-family = Symbols Nerd Font
font-size = 16
font-thicken = true
font-feature = calt
font-feature = liga
font-feature = zero

# ── Theme & Colors ────────────────────────────────────────
theme = Catppuccin Mocha
cursor-color = #F5C2E7
cursor-text = cell-background
selection-foreground = cell-background
selection-background = #F5C2E7
palette-generate = true
minimum-contrast = 1.1

# ── Background & Transparency ─────────────────────────────
background-opacity = 0.88
background-blur = 30
alpha-blending = linear-corrected

# ── Window & Appearance ───────────────────────────────────
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
window-decoration = false
macos-titlebar-style = transparent
macos-non-native-fullscreen = true
macos-option-as-alt = left
window-save-state = always
window-step-resize = true
window-vsync = true

# ── Cursor ────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.85
mouse-hide-while-typing = true
copy-on-select = clipboard

# ── Split & Window Polish ─────────────────────────────────
unfocused-split-opacity = 0.92
split-divider-color = #313244
split-preserve-zoom = navigation
grapheme-width-method = unicode

# ── Shell Integration & Behavior ──────────────────────────
shell-integration = detect
cursor-click-to-move = true
confirm-close-surface = false
clipboard-read = allow
clipboard-write = allow
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s

# ── Scrollback ────────────────────────────────────────────
scrollback-limit = 10000000

# ── Keybindings: Splits ───────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+k=goto_split:top
keybind = cmd+shift+j=goto_split:bottom
keybind = cmd+alt+h=resize_split:left,5
keybind = cmd+alt+l=resize_split:right,5
keybind = cmd+alt+k=resize_split:up,5
keybind = cmd+alt+j=resize_split:down,5
keybind = cmd+shift+z=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

# ── Keybindings: Tabs ─────────────────────────────────────
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+shift+[=previous_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+1=goto_tab:1
keybind = cmd+2=goto_tab:2
keybind = cmd+3=goto_tab:3
keybind = cmd+4=goto_tab:4
keybind = cmd+5=goto_tab:5
keybind = cmd+9=last_tab

# ── Keybindings: Font Size ────────────────────────────────
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# ── Keybindings: Search ───────────────────────────────────
keybind = cmd+f=start_search

# ── Keybindings: Quick Terminal ───────────────────────────
keybind = ctrl+`=toggle_quick_terminal
